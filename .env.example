# ==============================================================================
# VITRINEFOX — CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================

# Porta do Servidor
PORT=3000
NODE_ENV=development

# Senha Administrativa do Dono (Padrão inicial: felipe123!)
ADMIN_PASSWORD=felipe123!

# Chave secreta interna para assinatura de sessões administrativas
JWT_SECRET=sua_chave_secreta_super_segura_vitrinefox_2026

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL & STORAGE (Opcional para ambiente local, Obrigatório em produção)
# Caso não configurado, o VitrineFox utiliza o banco de dados persistente local em /data/vitrinefox_db.json
# ------------------------------------------------------------------------------
SUPABASE_URL=https://exemplo-seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_chave_publica_anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_chave_privada_service_role

# ------------------------------------------------------------------------------
# MERCADO PAGO (PAGAMENTOS REAIS — PIX, CARTÃO E BOLETO)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# ------------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADO_PAGO_WEBHOOK_SECRET=exemplo_webhook_secret_mp
